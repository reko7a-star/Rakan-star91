{
  "name": "markdown-enhancer",
  "displayName": "Markdown Enhancer",
  "description": "GitHub-like Markdown preview with alerts, spoilers and emoji.",
  "version": "1.0.0",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "main": "./out/extension.js",
  "activationEvents": ["onLanguage:markdown"],
  "contributes": {
    "markdown.previewStyles": ["./styles/github-style.css"],
    "markdown.markdownItPlugins": true,
    "markdown.previewScripts": ["./scripts/preview.js"]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "package": "vsce package"
  },
  "dependencies": {
    "markdown-it-container": "^4.0.0",
    "markdown-it-emoji": "^3.0.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.24.0"
  }
}
